# Copie para ".env" e preencha. O arquivo .env NUNCA deve ser commitado.
# No Google Colab, cadastre as mesmas chaves no painel "Secrets" (ícone de chave).

# Google Cloud: projeto usado para executar (e faturar) as consultas no BigQuery
GCP_PROJECT_ID=seu-projeto-gcp

# PostgreSQL no Aiven (valores em Aiven Console > Service > Overview,
# ou via "terraform output" em infra/terraform)
PG_HOST=seu-servico.aivencloud.com
PG_PORT=12345
PG_DATABASE=defaultdb
PG_USER=avnadmin
PG_PASSWORD=troque-aqui

# Primeiro ano do recorte temporal
ANO_INICIO=2015
